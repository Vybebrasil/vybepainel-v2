{
  "crons": [
    {
      "path": "/api/mirror-reconcile",
      "schedule": "0 3 * * *"
    }
  ],
  "buildCommand": "node scripts/check.mjs && npm run build",
  "ignoreCommand": "node scripts/vercel-construir.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/versao.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/aprovar/:t", "destination": "/api/painel?area=aprovar&t=:t" }
  ],
  "fluid": true,
  "regions": ["gru1"],
  "functions": {
    "api/*.js": {
      "maxDuration": 300,
      "includeFiles": "{assets/escritorio/habbo/**,vybe-escritorio-planta.js,vybe-escritorio-mapa.js,vybe-resumo.js,vybe-demandas.js,vybe-config.js,vybe-gestor.js}"
    }
  }
}
